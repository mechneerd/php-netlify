---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — PHP Learning Platform">
    <div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
        <p class="font-mono text-7xl font-bold text-violet-400">404</p>
        <h1 class="mt-4 text-2xl font-bold text-zinc-50">Lesson not found</h1>
        <p class="mt-2 max-w-md text-zinc-400">This page doesn't exist. Head back to the lesson index to find what you need.</p>
        <a href="/lessons/" class="mt-6 rounded-lg bg-violet-600 px-6 py-3 font-semibold text-white transition hover:bg-violet-500">
            Browse all lessons
        </a>
    </div>
</Base>
