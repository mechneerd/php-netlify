---
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'A static companion site for the PHP Learning Platform.' } = Astro.props;
const { pathname } = Astro.url;

const links = [
    { href: '/', label: 'Home' },
    { href: '/lessons/', label: 'Lessons' },
    { href: '/#features', label: 'Features' },
    { href: '/#stack', label: 'Stack' },
];

const isActive = (href: string) =>
    href === '/' ? pathname === '/' : pathname.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class="min-h-screen bg-zinc-950 text-zinc-300 antialiased">
        <header
            class="sticky top-0 z-50 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur"
        >
            <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
                <a href="/" class="flex items-center gap-2 font-bold text-zinc-50">
                    <span
                        class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-600 font-mono text-sm text-white"
                        >php</span
                    >
                    <span>Learning Platform</span>
                </a>
                <nav class="hidden items-center gap-6 text-sm sm:flex">
                    {
                        links.map((link) => (
                            <a
                                href={link.href}
                                class:list={[
                                    'transition-colors hover:text-zinc-50',
                                    isActive(link.href) ? 'text-zinc-50 font-semibold' : 'text-zinc-400',
                                ]}
                            >
                                {link.label}
                            </a>
                        ))
                    }
                </nav>
                <a
                    href="/lessons/"
                    class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-violet-500"
                >
                    Start learning
                </a>
            </div>
        </header>

        <main class="mx-auto max-w-6xl px-4 py-10">
            <slot />
        </main>

        <footer class="mt-16 border-t border-zinc-800">
            <div
                class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-8 text-sm text-zinc-500 sm:flex-row"
            >
                <p>&copy; 2026 PHP Learning Platform — static companion site.</p>
                <p>
                    Built with
                    <a href="https://astro.build" class="text-violet-400 hover:underline">Astro</a>
                    + Tailwind, hosted on
                    <a href="https://netlify.com" class="text-violet-400 hover:underline">Netlify</a
                    >.
                </p>
            </div>
        </footer>
    </body>
</html>
