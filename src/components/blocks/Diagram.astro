---
import type { Diagram } from '../../lib/content';

interface Props {
    diagram: Diagram;
}

const { diagram } = Astro.props;
---

<figure class="my-4 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/40">
    <figcaption class="flex items-center justify-between border-b border-zinc-800 px-4 py-2 text-xs">
        <span class="font-medium text-zinc-200">{diagram.title}</span>
        <span class="font-mono uppercase text-zinc-500">{diagram.kind}</span>
    </figcaption>
    <div class="mermaid flex justify-center overflow-x-auto p-4 text-zinc-200" data-processed="false">
        {diagram.mermaid_source}
    </div>
    {diagram.caption && <figcaption class="border-t border-zinc-800 px-4 py-2 text-xs text-zinc-500">{diagram.caption}</figcaption>}
</figure>
