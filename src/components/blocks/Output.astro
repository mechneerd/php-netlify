---
import type { Block } from '../../lib/content';

interface Props {
    block: Block;
}

const { block } = Astro.props;
---

<figure class="my-3 overflow-hidden rounded-xl border border-zinc-700 bg-zinc-900">
    <figcaption class="border-b border-zinc-700 px-4 py-2 text-xs font-medium tracking-wide text-zinc-500 uppercase">
        Output
    </figcaption>
    <pre class="overflow-x-auto p-4 font-mono text-sm leading-6 text-zinc-300">{block.payload.text ?? ''}</pre>
</figure>
